{
  "code": "B.18",
  "name": "营养风险筛查（NRS2002）",
  "dimension": "老年综合征",
  "method": "询问／测量",
  "standard_ref": "WS/T 888—2026 附录B B.18",
  "version": "0.1.0-draft",
  "review_status": "draft_pending_medical_review",
  "summary": "由体重下降、进食量减少与疾病严重程度三部分构成的营养风险筛查，总分 0~7 分。",
  "collection": {
    "support": [
      "patient",
      "staff"
    ],
    "proxy_allowed": true,
    "measured": true
  },
  "sections": [
    {
      "code": "screen",
      "title": "第一步：初筛",
      "questions": [
        {
          "code": "B18-S1",
          "text": "体质指数＜20.5 kg/m²",
          "plain_text": "按身高体重算出来的体质指数，是不是低于 20.5？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "yes",
              "label": "是",
              "score": 0
            },
            {
              "value": "no",
              "label": "否",
              "score": 0
            }
          ]
        },
        {
          "code": "B18-S2",
          "text": "最近 3 个月有无体质量减轻",
          "plain_text": "最近 3 个月，体重有没有往下掉？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "yes",
              "label": "是",
              "score": 0
            },
            {
              "value": "no",
              "label": "否",
              "score": 0
            }
          ]
        },
        {
          "code": "B18-S3",
          "text": "最近 1 周有无膳食摄入量减少",
          "plain_text": "最近 1 周，饭量是不是比以前少了？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "yes",
              "label": "是",
              "score": 0
            },
            {
              "value": "no",
              "label": "否",
              "score": 0
            }
          ]
        },
        {
          "code": "B18-S4",
          "text": "疾病是否严重（如重症监护室、大手术后）",
          "plain_text": "现在有没有很重的病，比如刚做完大手术、在重症监护？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "yes",
              "label": "是",
              "score": 0
            },
            {
              "value": "no",
              "label": "否",
              "score": 0
            }
          ]
        }
      ]
    },
    {
      "code": "final",
      "title": "第二步：终筛（初筛任一项为「是」时填写）",
      "questions": [
        {
          "code": "B18-T1",
          "text": "营养状态受损程度",
          "plain_text": "按体重下降、吃饭量和体质指数，营养状态受损到什么程度？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "0",
              "label": "正常营养状态",
              "score": 0
            },
            {
              "value": "1",
              "label": "3 个月体质量丢失＞5%，或进食量为平时的 50%～75%",
              "score": 1
            },
            {
              "value": "2",
              "label": "2 个月体质量丢失＞5%，或进食量为平时的 25%～50%，或体质指数 18.5～20.5",
              "score": 2
            },
            {
              "value": "3",
              "label": "1 个月体质量丢失＞5%（或 3 个月丢失＞15%），或进食量为平时的 25% 以下，或体质指数＜18.5",
              "score": 3
            }
          ],
          "when": {
            "any": [
              {
                "question": "B18-S1",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S2",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S3",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S4",
                "op": "eq",
                "value": "yes"
              }
            ]
          }
        },
        {
          "code": "B18-T2",
          "text": "疾病严重程度",
          "plain_text": "现在的病情对营养需求的影响有多大？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "0",
              "label": "正常能量需求",
              "score": 0
            },
            {
              "value": "1",
              "label": "髋骨骨折，或慢性疾病如肝硬化、慢性阻塞性肺疾病、长期血液透析、糖尿病、肿瘤",
              "score": 1
            },
            {
              "value": "2",
              "label": "腹部大手术、脑卒中、重症肺炎、血液系统恶性肿瘤",
              "score": 2
            },
            {
              "value": "3",
              "label": "颅脑损伤、骨髓移植、重症监护（APACHE＞10 分）",
              "score": 3
            }
          ],
          "when": {
            "any": [
              {
                "question": "B18-S1",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S2",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S3",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S4",
                "op": "eq",
                "value": "yes"
              }
            ]
          }
        },
        {
          "code": "B18-T3",
          "text": "年龄",
          "plain_text": "老人现在多大年纪？",
          "input_type": "single",
          "required": true,
          "options": [
            {
              "value": "lt70",
              "label": "70 岁以下",
              "score": 0
            },
            {
              "value": "ge70",
              "label": "70 岁及以上（加 1 分）",
              "score": 1
            }
          ],
          "when": {
            "any": [
              {
                "question": "B18-S1",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S2",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S3",
                "op": "eq",
                "value": "yes"
              },
              {
                "question": "B18-S4",
                "op": "eq",
                "value": "yes"
              }
            ]
          }
        },
        {
          "code": "B18-M1",
          "text": "身高",
          "plain_text": "现在给您量一下身高，记下来。",
          "input_type": "number",
          "required": true,
          "measure": {
            "unit": "cm",
            "hint": "记录实测值，仅作 BMI 计算与复核用，不参与计分"
          }
        },
        {
          "code": "B18-M2",
          "text": "体重",
          "plain_text": "现在给您称一下体重，记下来。",
          "input_type": "number",
          "required": true,
          "measure": {
            "unit": "kg",
            "hint": "记录实测值，仅作 BMI 计算与复核用，不参与计分"
          }
        }
      ]
    }
