{
  "code": "B.18",
  "name": "营养风险筛查（NRS2002）",
  "dimension": "老年综合征",
  "method": "询问／测量",
  "standard_ref": "WS/T 888—2026 附录B B.18",
  "version": "0.1.0-draft",
  "review_status": "draft_pending_medical_review",
  "summary": "由体重下降、进食量减少与疾病严重程度三部分构成的营养风险筛查，总分 0~7 分。",
  "collection": { "support": ["patient", "staff"], "proxy_allowed": true, "measured": true },
  "sections": [
    {
      "code": "B18-S1",
      "title": "营养风险筛查与测量",
      "questions": [
        {
          "code": "B18-01",
          "text": "体重下降（近 1 个月内）",
          "plain_text": "最近一个月，您的体重有没有下降？大概掉了多少？",
          "input_type": "single",
          "required": true,
          "options": [
            { "value": "0", "label": "没有下降", "score": 0 },
            { "value": "1", "label": "下降 1~5 kg", "score": 1 },
            { "value": "2", "label": "下降超过 5 kg 或说不清", "score": 2 }
          ]
        },
        {
          "code": "B18-02",
          "text": "进食量减少（近 1 个月内食欲下降或摄入量减少）",
          "plain_text": "最近一个月，您吃饭的量是不是比平时少了？",
          "input_type": "single",
          "required": true,
          "options": [
            { "value": "0", "label": "没有减少", "score": 0 },
            { "value": "1", "label": "有减少", "score": 2 }
          ]
        },
        {
          "code": "B18-03",
          "text": "疾病严重程度评分",
          "plain_text": "您现在的病情有多重？（由医护人员按病情判断）",
          "input_type": "single",
          "required": true,
          "options": [
            { "value": "0", "label": "无影响营养的疾病", "score": 0 },
            { "value": "1", "label": "轻度", "score": 1 },
            { "value": "2", "label": "中度", "score": 2 },
            { "value": "3", "label": "重度", "score": 3 }
          ]
        },
        {
          "code": "B18-04",
          "text": "体重实测值",
          "plain_text": "现在给您称一下体重，记下来。",
          "input_type": "number",
          "required": false,
          "unit": "kg",
          "options": []
        },
        {
          "code": "B18-05",
          "text": "身高实测值",
          "plain_text": "现在给您量一下身高，记下来。",
          "input_type": "number",
          "required": false,
          "unit": "cm",
          "options": []
        }
      ]
    }
  ],
  "scoring": {
    "score": {
      "rule_type": "sum",
      "config": {
        "items": [
          { "code": "B18-01", "label": "体重下降", "max_score": 2 },
          { "code": "B18-02", "label": "进食量减少", "max_score": 2 },
          { "code": "B18-03", "label": "疾病严重程度", "max_score": 3 }
        ]
      },
      "explanation": "体重下降（0~2 分）、进食量减少（0~2 分）与疾病严重程度（0~3 分）三项相加，满分 7 分；体重、身高实测值仅用于记录与随访对比，不参与计分。"
    },
    "levels": {
      "rule_type": "level_map",
      "config": {
        "levels": [
          { "min": 0, "max": 2, "level": "未达营养风险", "interpretation": "建议每周复评，持续监测体重与进食量。", "abnormal": false, "severity": "none" },
          { "min": 3, "max": 7, "level": "存在营养风险", "interpretation": "提示存在营养风险，建议尽快完成营养评估并启动营养干预。", "abnormal": true, "severity": "medium" }
        ]
      }
    },
    "flags": [
      {
        "rule_type": "condition",
        "config": { "any": [{ "question": "B18-01", "op": "gt", "value": 0 }] },
        "flag": "近 1 个月内体重下降",
        "symptom_codes": ["weight_loss", "low_bmi"],
        "severity": "medium"
      },
      {
        "rule_type": "condition",
        "config": { "any": [{ "question": "B18-02", "op": "eq", "value": "1" }] },
        "flag": "进食量减少",
        "symptom_codes": ["poor_appetite"],
        "severity": "medium"
      },
      {
        "rule_type": "condition",
        "config": { "any": [{ "question": "B18-03", "op": "gte", "value": 2 }] },
        "flag": "基础疾病程度较重",
        "symptom_codes": ["fatigue", "cachexia"],
        "severity": "medium"
      }
    ]
  },
  "branches": [
    {
      "code": "B18-B1",
      "when": {
        "any": [
          { "question": "B18-01", "op": "gt", "value": 0 },
          { "question": "B18-02", "op": "eq", "value": "1" }
        ]
      },
      "target_scale": "B.19",
      "reason": "存在体重下降或进食量减少，建议加做微营养评定（MNA-SF）确认营养不良风险。"
    }
  ],
  "notes": "条目按通用 NRS-2002 营养风险筛查预置草稿，发布前须以 WS/T 888—2026 附录 B 原文逐项核对。需求文档 §5.2 判读要点为「0~2 分每周复评，3~7 分存在营养风险」，本表据此将总分取值范围设为 0~7 分（体重下降 0~2 + 进食量减少 0~2 + 疾病严重程度 0~3）；具体条目数与各档取值待原文核对。"
}
