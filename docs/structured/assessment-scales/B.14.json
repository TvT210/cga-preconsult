          { "min": 4, "max": 6, "level": "中度疼痛", "interpretation": "中度疼痛，影响睡眠与日常活动，建议专科评估。", "abnormal": true, "severity": "medium" },
          { "min": 7, "max": 10, "level": "重度疼痛", "interpretation": "重度疼痛，明显影响生活自理与情绪，建议尽快就诊并评估镇痛方案。", "abnormal": true, "severity": "high" }
        ]
      }
    },
    "flags": [
      {
        "rule_type": "condition",
        "config": { "any": [{ "question": "B14-01", "op": "gte", "value": 4 }] },
        "flag": "中度及以上疼痛",
        "symptom_codes": ["pain_chronic"],
        "severity": "medium"
      },
      {
        "rule_type": "condition",
        "config": { "any": [{ "question": "B14-01", "op": "gte", "value": 7 }] },
        "flag": "重度疼痛",
        "symptom_codes": ["pain_chronic"],
        "severity": "high"
      }
    ]
  },
  "branches": [
    {
      "code": "B14-B1",
      "when": { "any": [{ "question": "B14-01", "op": "gte", "value": 7 }] },
      "target_scale": "B.15",
      "reason": "重度疼痛且部分老年人难以准确自评，建议加做慢性疼痛行为评估量表（他评）。"
    },
    {
      "code": "B14-B2",
      "when": { "any": [{ "question": "B14-01", "op": "gte", "value": 4 }] },
      "target_scale": "B.3",
      "reason": "疼痛达到中度以上，常伴活动受限，建议加做简易体能状况量表（SPPB）实测体能。"
