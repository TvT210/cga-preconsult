# 环境变量示例（复制为 .env 后按需修改，勿提交到仓库）
# 后端读取前缀 CGA_ 的环境变量；也可用仓库根 config.yaml 配置。

# 数据层：默认 SQLite；生产使用 PostgreSQL
# CGA_DATABASE_URL=postgresql+psycopg://cga:cga@127.0.0.1:5432/cga

# 鉴权密钥（生产必须替换）
CGA_JWT_SECRET=change-me-in-production
CGA_ACCESS_TOKEN_EXPIRE_MINUTES=720

# 大模型：mock（离线演示）/ openai_compatible（对接兼容 /chat/completions 的服务）
CGA_LLM_PROVIDER=mock
# CGA_LLM_BASE_URL=https://api.example.com/v1
# CGA_LLM_API_KEY=
# CGA_LLM_MODEL=

# 跨域来源
CGA_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 前端接口地址（frontend/.env.local）
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
